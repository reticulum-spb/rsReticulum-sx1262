{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SX1262 RNode configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device",
    "frequency",
    "bandwidth",
    "spreading_factor",
    "coding_rate",
    "tx_power"
  ],
  "properties": {
    "frequency": {
      "type": "integer",
      "title": "Frequency",
      "minimum": 150000000,
      "maximum": 960000000,
      "x-unit": "Hz",
      "x-ui-group": "Radio",
      "x-order": 10
    },
    "bandwidth": {
      "type": "integer",
      "title": "Bandwidth",
      "enum": [
        7800,
        10400,
        15600,
        20800,
        31250,
        41700,
        62500,
        125000,
        250000,
        500000
      ],
      "default": 125000,
      "x-unit": "Hz",
      "x-ui-group": "Radio",
      "x-order": 20
    },
    "spreading_factor": {
      "type": "integer",
      "title": "Spreading factor",
      "minimum": 5,
      "maximum": 12,
      "default": 7,
      "x-ui-group": "Radio",
      "x-order": 30
    },
    "coding_rate": {
      "type": "integer",
      "title": "Coding rate denominator",
      "enum": [
        5,
        6,
        7,
        8
      ],
      "default": 5,
      "x-ui-group": "Radio",
      "x-order": 40
    },
    "tx_power": {
      "type": "integer",
      "title": "TX power",
      "minimum": -9,
      "maximum": 30,
      "default": 22,
      "x-unit": "dBm",
      "x-ui-group": "Radio",
      "x-order": 50
    },
    "tx_preamble_symbols": {
      "type": "integer",
      "title": "TX preamble symbols",
      "minimum": 4,
      "maximum": 65535,
      "default": 25,
      "x-ui-group": "Protocol",
      "x-order": 11
    },
    "sync_word": {
      "type": "integer",
      "title": "Sync word",
      "minimum": 1,
      "maximum": 65535,
      "default": 5156,
      "x-ui-group": "Protocol",
      "x-order": 20
    },
    "irq_watchdog_seconds": {
      "type": "integer",
      "title": "IRQ watchdog",
      "minimum": 1,
      "maximum": 86400,
      "default": 60,
      "x-unit": "s",
      "x-ui-group": "Recovery",
      "x-order": 10
    },
    "hard_reset_after": {
      "type": "integer",
      "title": "Hard reset after",
      "minimum": 1,
      "maximum": 100,
      "default": 2,
      "description": "Consecutive watchdog recoveries before toggling RST",
      "x-ui-group": "Recovery",
      "x-order": 20
    },
    "device": {
      "type": "string",
      "minLength": 1,
      "default": "/dev/lora0",
      "title": "Linux LoRa device",
      "x-ui-group": "Hardware"
    },
    "tx_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400,
      "default": 120,
      "title": "TX completion timeout",
      "x-unit": "s"
    },
    "rx_preamble_symbols": {
      "type": "integer",
      "title": "RX preamble symbols",
      "minimum": 4,
      "maximum": 65535,
      "default": 65,
      "x-ui-group": "Protocol",
      "x-order": 10
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "spreading_factor": {
            "enum": [
              5,
              6
            ]
          }
        },
        "required": [
          "spreading_factor"
        ]
      },
      "then": {
        "properties": {
          "tx_preamble_symbols": {
            "minimum": 12
          },
          "rx_preamble_symbols": {
            "minimum": 12
          }
        }
      }
    }
  ]
}
